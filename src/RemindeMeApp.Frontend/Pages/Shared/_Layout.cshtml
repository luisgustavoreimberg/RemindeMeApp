<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RemindMeApp</title>
    
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
    
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/_content/RemindeMeApp.Frontend/css/site.css" asp-append-version="true" />
    
    <!-- Tailwind CDN for exact mockup fidelity -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "surface-container-low": "#131b2e", "secondary-fixed-dim": "#b9c8de", "outline": "#8c909f",
                        "on-secondary-fixed-variant": "#39485a", "tertiary-container": "#df7412", "tertiary-fixed-dim": "#ffb786",
                        "secondary-fixed": "#d4e4fa", "text-secondary": "#94a3b8", "on-surface-variant": "#c2c6d6",
                        "inverse-on-surface": "#283044", "surface-bright": "#31394d", "on-error": "#690005",
                        "tertiary": "#ffb786", "tertiary-fixed": "#ffdcc6", "on-tertiary-fixed": "#311400",
                        "secondary-container": "#39485a", "on-tertiary-fixed-variant": "#723600", "on-secondary-fixed": "#0d1c2d",
                        "surface-container": "#171f33", "tag-personal": "#22c55e", "background": "#0b1326",
                        "on-secondary": "#233143", "primary": "#adc6ff", "inverse-primary": "#005ac2",
                        "on-surface": "#dae2fd", "surface-container-high": "#222a3d", "surface-variant": "#2d3449",
                        "on-error-container": "#ffdad6", "on-primary-container": "#00285d", "on-secondary-container": "#a7b6cc",
                        "surface": "#0b1326", "error": "#ffb4ab", "on-primary": "#002e6a", "primary-fixed-dim": "#adc6ff",
                        "surface-dim": "#0b1326", "on-primary-fixed": "#001a42", "on-tertiary": "#502400",
                        "surface-tint": "#adc6ff", "tag-work": "#3b82f6", "tag-urgent": "#ef4444", "outline-variant": "#424754",
                        "inverse-surface": "#dae2fd", "surface-container-lowest": "#060e20", "border-subtle": "#334155",
                        "on-primary-fixed-variant": "#004395", "error-container": "#93000a", "primary-fixed": "#d8e2ff",
                        "surface-container-highest": "#2d3449", "primary-container": "#4d8eff", "surface-charcoal": "#1e293b",
                        "on-background": "#dae2fd", "on-tertiary-container": "#461f00", "secondary": "#b9c8de"
                    },
                    fontFamily: {
                        "headline-md": ["Inter"], "display": ["Inter"], "body-md": ["Inter"], "body-lg": ["Inter"],
                        "caption": ["Inter"], "headline-lg": ["Inter"], "label-md": ["JetBrains Mono"]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-background text-on-background h-screen flex flex-col font-body-md overflow-hidden">
    @Html.AntiForgeryToken()

    <!-- TopAppBar -->
    <header class="h-12 w-full flex-shrink-0 sticky top-0 border-b border-border-subtle bg-surface-container-lowest/80 backdrop-blur-xl flex items-center justify-between px-6 z-50">
        <div class="flex items-center gap-4">
            <span class="text-headline-md font-headline-md font-semibold text-on-surface">RemindMeApp</span>
        </div>
        <div class="flex items-center gap-4">
            <button id="dnd-toggle" class="text-label-md font-label-md text-on-surface-variant hover:bg-surface-variant/30 rounded-md px-3 py-1.5 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined dnd-icon" style="font-variation-settings: 'FILL' 0;" data-original-icon="do_not_disturb_on">do_not_disturb_on</span>
                Do Not Disturb
            </button>
        </div>
    </header>

    <div class="flex flex-1 overflow-hidden">
        <!-- SideNavBar -->
        <nav class="w-[280px] h-full flex-shrink-0 border-r border-border-subtle bg-surface-container flex flex-col justify-between py-6">
            <div class="flex flex-col gap-2">
                <div class="px-6 mb-8 flex flex-col items-center">
                    <div class="w-16 h-16 rounded-full mb-4 border-2 border-primary/20 flex items-center justify-center bg-surface-variant">
                        <span class="material-symbols-outlined text-3xl text-primary">person</span>
                    </div>
                    <h2 class="text-headline-md font-headline-md text-primary font-bold">RemindMeApp</h2>
                    <p class="text-body-md font-body-md text-text-secondary mt-1">Stay productive</p>
                </div>
                
                <div class="flex flex-col gap-1 w-full">
                    <!-- Dashboard -->
                    @{ var isDashboard = ViewContext.RouteData.Values["Page"]?.ToString() == "/Index" || ViewContext.RouteData.Values["Page"]?.ToString() == "/"; }
                    <a asp-page="/Index" class="flex items-center gap-3 px-4 py-3 @(isDashboard ? "text-primary bg-secondary-container/20 border-l-4 border-primary rounded-r-lg" : "text-on-surface-variant hover:bg-surface-variant/50 rounded-lg mx-2") transition-all">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(isDashboard ? "1" : "0");">dashboard</span>
                        <span class="text-label-md font-label-md">Dashboard</span>
                    </a>
                    
                    <!-- Focus Mode -->
                    @{ var isFocus = ViewContext.RouteData.Values["Page"]?.ToString() == "/Focus"; }
                    <a asp-page="/Focus" class="flex items-center gap-3 px-4 py-3 @(isFocus ? "text-primary bg-secondary-container/20 border-l-4 border-primary rounded-r-lg" : "text-on-surface-variant hover:bg-surface-variant/50 rounded-lg mx-2") transition-colors">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(isFocus ? "1" : "0");">timer</span>
                        <span class="text-label-md font-label-md">Focus Mode</span>
                    </a>
                    
                    <!-- Tags -->
                    @{ var isTags = ViewContext.RouteData.Values["Page"]?.ToString() == "/Tags"; }
                    <a asp-page="/Tags" class="flex items-center gap-3 px-4 py-3 @(isTags ? "text-primary bg-secondary-container/20 border-l-4 border-primary rounded-r-lg" : "text-on-surface-variant hover:bg-surface-variant/50 rounded-lg mx-2") transition-colors">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(isTags ? "1" : "0");">label</span>
                        <span class="text-label-md font-label-md">Tags</span>
                    </a>
                    
                    <!-- Settings -->
                    @{ var isSettings = ViewContext.RouteData.Values["Page"]?.ToString() == "/Settings"; }
                    <a asp-page="/Settings" class="flex items-center gap-3 px-4 py-3 @(isSettings ? "text-primary bg-secondary-container/20 border-l-4 border-primary rounded-r-lg" : "text-on-surface-variant hover:bg-surface-variant/50 rounded-lg mx-2") transition-colors">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(isSettings ? "1" : "0");">settings</span>
                        <span class="text-label-md font-label-md">Settings</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <main class="flex-1 flex flex-col h-full bg-background relative overflow-hidden">
            @RenderBody()
        </main>
    </div>

    <script src="~/_content/RemindeMeApp.Frontend/js/timer.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
